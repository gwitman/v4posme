        "jsCode": "// 1. Obtener todos los contactos devueltos por la API\nconst rawItems = $input.all();\nconst outputItems = [];\n\n// 2. Recorrer la lista devuelta por Evolution API\nfor (const item of rawItems) {\n  const datos = item.json;\n\n  // Extraer el JID/Teléfono y limpiar sufijos de WhatsApp (@s.whatsapp.net, @c.us)\n  const rawJid = datos.id || datos.jid || \"\";\n  const numeroTelefono = rawJid.replace(\"@s.whatsapp.net\", \"\").replace(\"@c.us\", \"\").trim();\n\n  // Obtener el nombre del contacto\n  const nombreContacto = datos.pushName || datos.name || datos.verifiedName || \"Amigo/a\";\n\n  // Filtrar: Excluir grupos (@g.us) y registros sin número válido\n  if (numeroTelefono && !rawJid.includes(\"@g.us\")) {\n    outputItems.push({\n      json: {\n        nombre: nombreContacto,\n        telefono: numeroTelefono\n      }\n    });\n  }\n}\n\n// 3. Retornar cada contacto como un elemento independiente para el Loop\nreturn outputItems.slice(0, 2);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
