    {
      "parameters": {
        "jsCode": "// Obtener todas las filas traídas desde la Data Table\nconst items = $input.all();\nif (items.length === 0) return [];\n\nconst remoteJid = $('recibir whatsapp').item.json.body.data.key.remoteJid;\n\n// Obtener el timestamp del mensaje de ESTA ejecución\nconst myTimestamp = Number($('Insert row').item.json.timestamp);\n\n// Encontrar el timestamp más reciente guardado en la Data Table para este usuario\nconst maxTimestamp = Math.max(...items.map(item => Number(item.json.timestamp)));\n\n// Si entró un mensaje posterior a este, CANCELAMOS esta ejecución para evitar duplicados\nif (maxTimestamp > myTimestamp) {\n  return []; \n}\n\n// Si esta es la ejecución más reciente, unificamos todos los textos acumulados\nconst textoConsolidado = items.map(item => item.json.mensaje).join(\"\\n\");\n\nreturn [{\n  json: {\n    mensaje_consolidado_buffer: textoConsolidado,\n    buffer_remoteJid: remoteJid\n  }\n}];"
      },
